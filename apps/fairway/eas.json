{
  "cli": {
    "requireCommit": false,
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true
    }
  }
}
