    "@nx/js": "23.1.0",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.32",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.1",
    "better-sqlite3": "^12.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^30.0.2",
